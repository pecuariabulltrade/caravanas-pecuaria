# Copiar como .env en esta misma carpeta (sync\.env) y completar.
# WinCampo Web: si se dejan vacíos, el script usa el .env del portal PEGSA (OneDrive\PEGSA_Portal\.env)
WINCAMPO_EMAIL=
WINCAMPO_PASSWORD=
# Supabase del proyecto caravanas-pecuaria (Settings -> API Keys -> "Secret keys", la que empieza con sb_secret_)
SUPABASE_URL=https://xqcipsnyvnozkvehpzsk.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_PEGAR_ACA
# VISEC (https://carne.visec.com.ar): usuario y clave con los que se entra a la pagina
VISEC_USUARIO=
VISEC_CLAVE=
# Segundo usuario de VISEC (opcional): cada usuario tiene su propia cola en VISEC, con dos se consulta el doble
VISEC_USUARIO2=
VISEC_CLAVE2=
# Opcionales: caravanas por lote, lotes a la vez, minutos maximos por corrida (la tarea corre cada hora) y reintentos por error de ARCA
# VISEC_LOTE=15
# VISEC_PARALELO=1
# VISEC_MAX_MIN=55
# VISEC_REINTENTOS=2
